# FinKaya - Personal Finance Application
# Database connection:
# SQLite (Local): "file:./dev.db"
# PostgreSQL (Production): "postgresql://username:password@localhost:5432/finkaya?schema=public"
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-generated-secret-key-here-minimum-32-characters"

# App settings
NEXT_PUBLIC_APP_NAME="FinKaya"
NEXT_PUBLIC_DEFAULT_CURRENCY="IDR"
